া\"/><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\"/><link rel=\"icon\" href=\"/icon.svg\"/><link rel=\"apple-touch-icon\" href=\"/icon.svg\"/><link href=\"https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@500;600;700&amp;family=Noto+Sans+Bengali:wght@500;600;700;800;900&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body style=\"font-family:&#x27;Noto Sans Bengali&#x27;, &#x27;Hind Siliguri&#x27;, sans-serif;font-weight:500\"><div hidden=\"\"><!--$--><!--/$--></div><!--$--><div class=\"min-h-screen bg-gradient-to-br from-[#f8fafc] via-white to-[#ede9fe] text-gray-800 p-4 sm:p-8\"><div class=\"max-w-xl mx-auto\"><div class=\"text-center mb-8 pt-4\"><h1 class=\"text-3xl sm:text-4xl font-bold text-[#7c3aed] mb-2\">ব্যালেন্স রিচার্জ করুন</h1><p class=\"text-gray-500 text-xs sm:text-sm font-medium\">আপনার অ্যাকাউন্টে ব্যালেন্স যোগ করতে নিচের ফর্মটি পূরণ করুন</p></div><div class=\"bg-white rounded-[2.5rem] p-6 sm:p-10 shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-gray-100\"><div class=\"flex bg-gray-100/80 p-1.5 rounded-2xl mb-8\"><button class=\"flex-1 py-3 rounded-xl font-bold transition-all bg-[#7c3aed] text-white shadow-md\">Personal Account</button><button class=\"flex-1 py-3 rounded-xl font-bold transition-all text-gray-500 hover:text-gray-700\">Business Account</button></div><div class=\"bg-green-50 border border-green-200 rounded-2xl px-5 py-4 mb-6 flex items-center gap-3\"><div class=\"w-9 h-9 rounded-xl bg-green-100 flex items-center justify-center flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-green-600\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><polyline points=\"22 4 12 14.01 9 11.01\"></polyline></svg></div><div><p class=\"text-green-800 font-black text-sm\">তাৎক্ষণিক ব্যালেন্স যোগ!</p><p class=\"text-green-700 text-xs mt-0.5\">সাবমিট করার সাথে সাথেই আপনার ব্যালেন্সে টাকা যোগ হবে।</p></div></div><div class=\"bg-[#f8fafc] border border-violet-100 p-5 rounded-2xl mb-6 text-center\"><p class=\"text-violet-600 font-semibold text-sm mb-1\">Personal অ্যাকাউন্টের জন্য সর্বনিম্ন</p><p class=\"text-[#2e1065] font-black text-3xl tracking-wide\">৫০০ টাকা</p><p class=\"text-violet-500 text-xs mt-1\">অ্যাড করতে হবে</p></div><div class=\"relative overflow-hidden bg-gradient-to-r from-[#2e1065] to-[#7c3aed] rounded-2xl p-5 mb-8 text-white\"><div class=\"absolute top-0 right-0 w-32 h-32 rounded-full bg-white/5 blur-2xl\"></div><div class=\"relative flex items-start gap-4\"><div class=\"w-12 h-12 rounded-xl bg-white/15 flex items-center justify-center text-2xl flex-shrink-0\">👑</div><div><p class=\"font-bold text-base mb-1\">সাব এডমিন হওয়ার সুযোগ!</p><p class=\"text-violet-100 text-sm leading-relaxed\">আমাদের একাউন্টে <span class=\"font-black text-white bg-white/20 px-2 py-0.5 rounded-lg\">সাব এডমিন</span> নিতে চাইলে মাত্র</p><p class=\"text-3xl font-black mt-2 text-violet-300\">২,৯৫০ ৳</p><p class=\"text-violet-200 text-xs mt-1\">একবার যোগ করুন — সারাজীবন সুবিধা উপভোগ করুন</p></div></div></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10\"><div class=\"bg-pink-50/30 border border-pink-100/50 p-5 rounded-2xl hover:bg-gradient-to-r hover:from-pink-50 hover:to-rose-50 hover:border-pink-300 hover:shadow-[0_8px_30px_rgba(226,19,110,0.15)] hover:-translate-y-1 transition-all duration-300 relative group\"><p class=\"text-[#e2136e] text-xs font-bold mb-2 uppercase tracking-tight\">bKash (Personal)</p><div class=\"flex items-center justify-between\"><span class=\"text-xl font-bold tracking-wider text-gray-800\">01904275901</span><button class=\"flex items-center gap-1.5 bg-white border border-gray-200 hover:bg-gray-50 px-2.5 py-1.5 rounded-lg text-xs font-medium text-gray-600 transition-colors shadow-sm\"><svg x